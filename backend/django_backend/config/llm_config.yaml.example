# LLM 规范配置。首次使用时可复制为 config/llm_config.yaml 并按需修改。
# config/llm_config.yaml 被 Git 忽略；本文件是可审查、可复现的配置契约。

LLM_PROVIDER: ollama
EMBEDDING_PROVIDER: auto
LLM_GENERATION_RETRIES: 2
LLM_MIN_OUTPUT_CHARS: 50
LLM_MAX_PARTS_NUM: 3
LLM_MAX_PART_LENGTH: 70
STRUCTURED_REPAIR_RETRIES: 1
MAX_PROMPT_CONTEXT_CHARS: 12000

RESPONSE_TOP_K: 10
INDEX_BUILD_BATCH_SIZE: 4
RETRIEVAL_MIN_SCORE: 0.0
RETRIEVAL_MODE: vector
RETRIEVAL_CANDIDATE_MULTIPLIER: 3
HYBRID_VECTOR_WEIGHT: 0.7
HYBRID_LEXICAL_WEIGHT: 0.3
RERANKER_ENABLED: false
MODEL_CACHE_MAX_SIZE: 4
REPLY_CACHE_TTL: 3600
PROMPT_VERSION: 'm5-v1'
INDEX_VERSION: 'v1'
CACHE_SCHEMA_VERSION: 'm5-v1'

HISTORY_MODE: 'auto'
HISTORY_MAX_TURNS: 8
HISTORY_TOP_K: 3
HISTORY_SIM_THRESHOLD: 0.25
HISTORY_MAX_TOKENS: 1000

LOG_PATH: 'data/log'
SYSTEM_PROMPT_PATH: 'config/system_prompt.yaml'
RESPONSE_TEMPLATE_PATH: 'config/response_template.md'
VECTOR_STORE_PATH: 'data/vector_stores'

OLLAMA_CONFIG:
  model: 'deepseek-r1:7b'
  embedding_model: 'bge-large:latest'
  format: 'json'
  max_new_tokens: 600
  host: 'http://localhost:11434'
  port: 11434
  api_key: 'ollama'

TRANSFORMERS_CONFIG:
  llm_model: 'Qwen/Qwen2.5-1.5B-Instruct'
  device: 'auto'
  device_map: 'auto'
  torch_dtype: 'auto'
  trust_remote_code: false
  max_new_tokens: 600
  temperature: 0.7
  top_p: 0.95
  repetition_penalty: 1.1
  do_sample: true
  use_flash_attention_2: false
  embedding_model: 'sentence-transformers/all-MiniLM-L6-v2'
  embedding_device: 'auto'
  embedding_batch_size: 32

OPENAI_COMPAT_CONFIG:
  base_url: 'https://api.openai.com/v1'
  api_key_env_name: 'OPENAI_API_KEY'
  organization: ''
  timeout: 60
  max_retries: 2
  model: 'gpt-4o-mini'
  embedding_model: 'text-embedding-3-large'
  embedding_dimensions: 3072

DASHSCOPE_CONFIG:
  base_url: 'https://dashscope.aliyuncs.com/compatible-mode/v1'
  api_key_env_name: 'DASHSCOPE_API_KEY'
  timeout: 60
  max_retries: 2
  chat_model: 'qwen-turbo'
  embedding_model: 'text-embedding-v4'
  embedding_dimensions: 1024
