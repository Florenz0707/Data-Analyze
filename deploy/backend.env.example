# Copy to deploy/backend.env and change secrets/configuration before production use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8082

# The default compose stack uses the PostgreSQL config mounted by docker-compose.yml.
ENABLE_LLM=false
PRELOAD_LLM_ON_STARTUP=false

# Persistent structured logs are mounted to BACKEND_LOG_DIR by Compose.
PERSISTENT_LOG_ENABLED=true
PERSISTENT_LOG_LEVEL=INFO
PERSISTENT_LOG_ROTATION_WHEN=midnight
PERSISTENT_LOG_ROTATION_INTERVAL=1
PERSISTENT_LOG_BACKUP_COUNT=14
PERSISTENT_LOG_UTC=true
