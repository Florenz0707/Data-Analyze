# Load this file explicitly: docker compose --env-file deploy/.env up --build

COMPOSE_PROJECT_NAME=data-analyze

# Published ports on the Docker host. Container ports are configurable too.
BACKEND_PUBLISHED_PORT=8081
BACKEND_CONTAINER_PORT=8000
FRONTEND_PUBLISHED_PORT=8082
FRONTEND_CONTAINER_PORT=8080

# Compose service and image configuration.
BACKEND_SERVICE_NAME=backend
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_PORT=5432
POSTGRES_SERVICE_NAME=db
POSTGRES_DB=data_analyze
POSTGRES_USER=data_analyze
POSTGRES_PASSWORD=change-this-password
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_PORT=6379
REDIS_SERVICE_NAME=redis
# Optional external Redis URL. Leave unset to use the Compose Redis service.
# REDIS_URL=redis://redis:6379/0

# Host-side configuration/data paths, relative to the repository root.
BACKEND_ENV_FILE=./deploy/backend.env.example
BACKEND_DB_CONFIG_FILE=./deploy/db_config.yaml.example
BACKEND_LLM_CONFIG_FILE=./deploy/llm_config.yaml.example
BACKEND_DATA_DIR=./.runtime/backend-data
BACKEND_LOG_DIR=./.runtime/log

# Frontend build-time configuration.
VITE_API_BASE_URL=/api
