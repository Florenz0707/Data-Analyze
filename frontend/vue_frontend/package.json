{
  "name": "deepseek-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "20.20.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write --ignore-unknown --config ../../.prettierrc.json --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-unknown --config ../../.prettierrc.json --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.11.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-tabler-icons": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
