{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-analyze.local/schema/m0-evaluation-case.json",
  "title": "M0 fault diagnosis evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "category",
    "query",
    "is_negative",
    "relevant_log_ids",
    "expected_causes",
    "expected_steps",
    "forbidden_advice",
    "annotation"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,31}$"
    },
    "category": {
      "enum": ["python", "java", "linux_command", "windows_event", "generic_service"]
    },
    "query": {
      "type": "string",
      "minLength": 8
    },
    "is_negative": {
      "type": "boolean"
    },
    "relevant_log_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^:]+\\.csv:[0-9]{6}$"
      }
    },
    "expected_causes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "expected_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "forbidden_advice": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewers", "status"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewer_types": {
          "type": "object",
          "additionalProperties": {
            "enum": ["human", "ai_assisted"]
          }
        },
        "status": {
          "enum": ["draft", "pending_human_review", "reviewed", "conflict"]
        }
      }
    }
  }
}
